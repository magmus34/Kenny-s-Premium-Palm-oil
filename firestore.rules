rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products: anyone can browse published palm oil products
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders: anyone can submit checkout orders; order status can be updated
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Settings: anyone can read store branding and bank transfer details
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
